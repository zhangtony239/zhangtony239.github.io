---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { SITE_NAME } from '../../../consts';
import { LOCALES, type Locale, localizedPath } from '../../../i18n/config';
import { useUi } from '../../../i18n/ui';
import { formatDate, groupByYear, parseEssayId } from '../../../lib/essays';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { lang: locale }, props: { locale } }));
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = useUi(locale);
const groups = await groupByYear(locale);
---

<BaseLayout title={`${ui.essays.title} · ${SITE_NAME}`} {locale}>
  <main class="archive">
    <h1 class="page-title">{ui.essays.title}</h1>

    {
      groups.length === 0 ? (
        <p class="empty">{ui.archive.empty}</p>
      ) : (
        groups.map((group) => (
          <section class="group">
            <h2 class="year">{group.year}</h2>
            <ul class="rows">
              {group.essays.map((essay) => (
                <li>
                  <a class="row" href={localizedPath(locale, `/essays/${parseEssayId(essay.id).slug}`)}>
                    <time class="date" datetime={essay.data.date.toISOString()}>
                      {formatDate(essay.data.date)}
                    </time>
                    <span class="title">{essay.data.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      )
    }
  </main>
</BaseLayout>

<style>
  .archive {
    max-width: 780px;
    min-height: 100svh;
    margin: 0 auto;
    padding: calc(var(--spacing-nav-h) + var(--spacing-2xl)) var(--spacing-pad-x) var(--spacing-3xl);
  }

  .page-title {
    margin: 0 0 var(--spacing-xl);
    font-size: var(--text-step--1);
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--color-ink-2);
  }

  .empty {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-step--2);
    letter-spacing: 0.06em;
    color: var(--color-ink-3);
  }

  .group + .group {
    margin-top: var(--spacing-l);
  }

  .year {
    margin: 0;
    padding: 0 0 var(--spacing-2xs);
    font-family: var(--font-mono);
    font-size: var(--text-step--2);
    font-weight: 400;
    letter-spacing: 0.2em;
    color: var(--color-ink-3);
  }

  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-line);
  }

  .row {
    display: grid;
    grid-template-columns: 82px 1fr;
    gap: var(--spacing-s);
    align-items: baseline;
    padding: var(--spacing-xs) var(--spacing-2xs) var(--spacing-xs) 0;
    border-bottom: 1px solid var(--color-line);
    transition:
      background 0.18s ease,
      padding-left 0.18s ease;
  }

  .row:hover {
    padding-left: var(--spacing-2xs);
    background: var(--color-accent-hover);
  }

  .date {
    font-family: var(--font-mono);
    font-size: var(--text-step--2);
    letter-spacing: 0.04em;
    color: var(--color-ink-3);
    transition: color 0.18s ease;
  }

  .row:hover .date {
    color: var(--color-ink-2);
  }

  .title {
    font-size: var(--text-step-0);
    color: var(--color-ink);
    overflow-wrap: anywhere;
    transition: color 0.18s ease;
  }

  .row:hover .title {
    color: var(--color-accent-deep);
  }
</style>
