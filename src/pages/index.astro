---
import '../styles/global.css';
import { DEFAULT_LOCALE, LOCALE_LABELS, LOCALES, localizedPath } from '../i18n/config';

const fallbackHref = localizedPath(DEFAULT_LOCALE, '/');
---

<!doctype html>
<html lang={DEFAULT_LOCALE} data-locale={DEFAULT_LOCALE}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Tony Zhang</title>
    {
      LOCALES.map((locale) => (
        <link rel="alternate" hreflang={locale} href={localizedPath(locale, '/')} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={fallbackHref} />
    <noscript><meta http-equiv="refresh" content="0;url=/en/" /></noscript>
    <script is:inline>
      (function () {
        var SUPPORTED = ['en', 'zh-cn', 'ja'];
        var target = null;

        try {
          var stored = window.localStorage.getItem('locale');
          if (stored && SUPPORTED.indexOf(stored) !== -1) target = stored;
        } catch (error) {
          /* 本地存储不可用时静默忽略，继续按浏览器语言判断。 */
        }

        if (!target) {
          var languages =
            navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language];

          for (var i = 0; i < languages.length; i += 1) {
            var tag = String(languages[i] || '').toLowerCase();
            var matched = null;

            if (tag === 'zh' || tag.indexOf('zh-') === 0) matched = 'zh-cn';
            else if (tag === 'ja' || tag.indexOf('ja-') === 0) matched = 'ja';
            else if (tag === 'en' || tag.indexOf('en-') === 0) matched = 'en';

            if (matched) {
              target = matched;
              break;
            }
          }
        }

        window.location.replace('/' + (target || 'en') + '/');
      })();
    </script>
  </head>
  <body>
    <main class="entry">
      <h1 class="entry-title">Tony Zhang</h1>
      <ul class="entry-links">
        {
          LOCALES.map((locale) => (
            <li>
              <a href={localizedPath(locale, '/')} lang={locale} hreflang={locale}>
                {LOCALE_LABELS[locale]}
              </a>
            </li>
          ))
        }
      </ul>
    </main>
  </body>
</html>

<style>
  .entry {
    display: grid;
    place-items: center;
    align-content: center;
    gap: var(--spacing-m);
    min-height: 100svh;
    padding: var(--spacing-pad-x);
    text-align: center;
  }

  .entry-title {
    margin: 0;
    font-size: var(--text-step--1);
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--color-ink-2);
  }

  .entry-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-2xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .entry-links a {
    display: inline-block;
    padding: var(--spacing-2xs) var(--spacing-s);
    border: 1px solid var(--color-line);
    border-radius: 999px;
    font-size: var(--text-step--1);
    letter-spacing: 0.03em;
    color: var(--color-ink-2);
    transition:
      color 0.2s ease,
      background 0.2s ease;
  }

  .entry-links a:hover {
    color: var(--color-ink);
    background: var(--color-hover-fill);
  }
</style>
