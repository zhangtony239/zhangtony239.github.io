---
import { Content, frontmatter } from '../manifesto/what-is-p-acc.md';
import ArticleLayout from '../layouts/ArticleLayout.astro';

const title = String(frontmatter.title);
const date = new Date(frontmatter.date);
const aigc = frontmatter.aigc === true;
---

<ArticleLayout {title} {date} {aigc}>
  <Content />
</ArticleLayout>
