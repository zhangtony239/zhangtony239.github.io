---
import { DEFAULT_LOCALE, type Locale, localizedPath, stripLocale } from '../i18n/config';
import { useUi } from '../i18n/ui';

interface Props {
  /** 当前页面语言，决定导航文案与链接前缀。 */
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const ui = useUi(locale);

/** 当前项判定先剥掉语言前缀，再对齐页面路径。 */
const current = stripLocale(Astro.url.pathname).replace(/\/+$/, '') || '/';

const items = [
  { label: ui.nav.home, href: localizedPath(locale, '/'), isCurrent: current === '/' },
  {
    label: ui.nav.pacc,
    href: localizedPath(locale, '/what-is-p-acc'),
    isCurrent: current === '/what-is-p-acc',
  },
  {
    label: ui.nav.essays,
    href: localizedPath(locale, '/essays'),
    isCurrent: current === '/essays' || current.startsWith('/essays/'),
  },
];
---

<nav class="nav" aria-label={ui.nav.label}>
  <ul class="nav-links">
    {
      items.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={item.isCurrent ? 'page' : undefined}
          >
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .nav {
    position: fixed;
    top: var(--spacing-s);
    left: 50%;
    transform: translateX(-50%);
    z-index: 100;
    display: flex;
    align-items: center;
    max-width: calc(100vw - var(--spacing-m));
    padding: var(--spacing-3xs);
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-glass);
    -webkit-backdrop-filter: blur(20px) saturate(1.7);
    backdrop-filter: blur(20px) saturate(1.7);
    box-shadow:
      inset 0 1px 0 var(--color-glass-hi),
      0 1px 3px var(--color-shadow-soft),
      0 10px 30px var(--color-shadow-soft);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav a {
    display: inline-block;
    padding: var(--spacing-2xs) var(--spacing-s);
    border-radius: 999px;
    font-size: var(--text-step--1);
    line-height: 1.4;
    letter-spacing: 0.03em;
    white-space: nowrap;
    color: var(--color-ink-2);
    transition:
      color 0.2s ease,
      background 0.2s ease;
  }

  .nav a:hover {
    color: var(--color-ink);
    background: var(--color-hover-fill);
  }

  .nav a[aria-current='page'] {
    color: var(--color-ink);
    background: var(--color-accent-current);
  }

  @media (max-width: 560px) {
    .nav {
      top: var(--spacing-xs);
    }

    .nav-links {
      gap: 0;
    }

    .nav a {
      padding: var(--spacing-2xs) var(--spacing-xs);
    }
  }
</style>
