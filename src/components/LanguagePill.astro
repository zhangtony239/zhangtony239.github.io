---
import {
  DEFAULT_LOCALE,
  HTML_LANG,
  LOCALE_LABELS,
  LOCALE_SHORT_LABELS,
  LOCALES,
  type Locale,
} from '../i18n/config';
import { useUi } from '../i18n/ui';

interface Props {
  /** 当前页面语言。 */
  locale?: Locale;
  /** 每个语言对应的目标路径；缺译时由页面传入该语言首页。 */
  paths: Record<Locale, string>;
}

const { locale = DEFAULT_LOCALE, paths } = Astro.props;
const ui = useUi(locale);

const entries = LOCALES.map((item) => ({
  locale: item,
  label: LOCALE_LABELS[item],
  short: LOCALE_SHORT_LABELS[item],
  href: paths[item],
  lang: HTML_LANG[item],
  isCurrent: item === locale,
}));
---

<div class="lang">
  <details class="lang-compact">
    <summary aria-label={`${ui.language.menuLabel}: ${LOCALE_LABELS[locale]}`}>
      <span class="mark" aria-hidden="true">{LOCALE_SHORT_LABELS[locale]}</span>
      <span class="sr-only">{LOCALE_LABELS[locale]}</span>
    </summary>
    <div class="lang-menu">
      <div class="lang-track">
        <span class="lang-active" aria-hidden="true"></span>
        <span class="lang-hover" aria-hidden="true"></span>
        <ul class="lang-list">
          {
            entries.map((entry) => (
              <li>
                <a
                  href={entry.href}
                  hreflang={entry.lang}
                  lang={entry.lang}
                  aria-current={entry.isCurrent ? 'true' : undefined}
                  data-locale-link={entry.locale}
                >
                  {entry.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </details>
</div>

<script is:inline>
  (function () {
    var langRoot = document.currentScript && document.currentScript.previousElementSibling;
    var details = langRoot instanceof HTMLElement ? langRoot.querySelector('.lang-compact') : null;
    var list = langRoot instanceof HTMLElement ? langRoot.querySelector('.lang-list') : null;
    var activePill = langRoot instanceof HTMLElement ? langRoot.querySelector('.lang-active') : null;
    var hoverPill = langRoot instanceof HTMLElement ? langRoot.querySelector('.lang-hover') : null;

    var hoverVisible = false;
    var hoveredLink = null;
    var focusedLink = null;
    var closeTimer = null;
    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)');

    function syncActive() {
      if (!(list instanceof HTMLElement) || !(activePill instanceof HTMLElement)) return;
      var current = list.querySelector('a[aria-current="true"]');
      if (!(current instanceof HTMLElement)) {
        activePill.style.opacity = '0';
        return;
      }
      activePill.style.transform = 'translateY(' + current.offsetTop + 'px)';
      activePill.style.height = current.offsetHeight + 'px';
      activePill.style.opacity = '1';
    }

    function moveHover(target) {
      if (!(hoverPill instanceof HTMLElement)) return;
      if (!(target instanceof HTMLElement)) {
        hoverPill.style.opacity = '0';
        hoverVisible = false;
        return;
      }

      var y = target.offsetTop;
      var h = target.offsetHeight;

      if (!hoverVisible) {
        hoverPill.style.transition = 'opacity 0.18s ease';
        hoverPill.style.transform = 'translateY(' + y + 'px)';
        hoverPill.style.height = h + 'px';
        void hoverPill.offsetHeight;
        hoverPill.style.opacity = '1';
        hoverPill.style.transition = '';
        hoverVisible = true;
      } else {
        hoverPill.style.transform = 'translateY(' + y + 'px)';
        hoverPill.style.height = h + 'px';
        hoverPill.style.opacity = '1';
      }
    }

    function startOpen() {
      if (!(details instanceof HTMLDetailsElement)) return;
      if (closeTimer) {
        clearTimeout(closeTimer);
        closeTimer = null;
      }
      syncActive();
      void details.offsetWidth;
      details.classList.add('is-open');
    }

    function closeMenu(menu) {
      if (!(menu instanceof HTMLDetailsElement) || !menu.open) return;
      menu.classList.remove('is-open');
      hoveredLink = null;
      focusedLink = null;
      moveHover(null);

      if (closeTimer) clearTimeout(closeTimer);
      var delay = reduceMotion && reduceMotion.matches ? 0 : 180;
      closeTimer = setTimeout(function () {
        menu.open = false;
        closeTimer = null;
      }, delay);
    }

    if (details instanceof HTMLDetailsElement && list instanceof HTMLElement) {
      if (langRoot instanceof HTMLElement) langRoot.setAttribute('data-ready', '');

      var summaryEl = details.querySelector('summary');
      if (summaryEl instanceof HTMLElement) {
        summaryEl.addEventListener('click', function (event) {
          if (!details.open) return;
          event.preventDefault();
          if (details.classList.contains('is-open')) {
            closeMenu(details);
          } else {
            startOpen();
          }
        });
      }

      details.addEventListener('toggle', function () {
        if (details.open) {
          startOpen();
        } else {
          details.classList.remove('is-open');
          hoveredLink = null;
          focusedLink = null;
          moveHover(null);
        }
      });

      list.addEventListener('pointerover', function (event) {
        var target = event.target;
        var link = target instanceof Element ? target.closest('a') : null;
        if (!(link instanceof HTMLElement) || !list.contains(link)) return;
        hoveredLink = link;
        moveHover(link);
      });

      list.addEventListener('pointerleave', function () {
        hoveredLink = null;
        moveHover(focusedLink);
      });

      list.addEventListener('focusin', function (event) {
        var target = event.target;
        if (!(target instanceof HTMLElement) || target.tagName !== 'A') return;
        if (!target.matches(':focus-visible')) return;
        focusedLink = target;
        moveHover(target);
      });

      list.addEventListener('focusout', function () {
        focusedLink = null;
        requestAnimationFrame(function () {
          var active = document.activeElement;
          if (active instanceof HTMLElement && list.contains(active) && active.matches(':focus-visible')) {
            focusedLink = active;
            moveHover(active);
          } else {
            moveHover(hoveredLink);
          }
        });
      });
    }

    function openMenu() {
      return document.querySelector('.lang-compact[open]');
    }

    document.addEventListener('click', function (event) {
      var target = event.target;
      var menu = openMenu();

      /* 点菜单内部（含语言条目）交给浏览器处理；点别处收起。 */
      if (menu && target instanceof Node && !menu.contains(target)) {
        closeMenu(menu);
      }

      var link = target instanceof Element ? target.closest('[data-locale-link]') : null;
      if (!link) return;

      try {
        window.localStorage.setItem('locale', link.getAttribute('data-locale-link') || '');
      } catch (error) {
        /* 本地存储不可用时静默失败：链接照常导航，只是不记住偏好。 */
      }
    });

    /* Esc 收起并把焦点还给按钮，保持键盘可达。 */
    document.addEventListener('keydown', function (event) {
      if (event.key !== 'Escape') return;

      var menu = openMenu();
      if (!menu) return;

      closeMenu(menu);
      var summary = menu.querySelector('summary');
      if (summary instanceof HTMLElement) summary.focus();
    });
  })();
</script>

<style>
  .lang {
    position: fixed;
    top: var(--spacing-s);
    right: max(var(--spacing-xs), calc(var(--spacing-pad-x) / 2));
    z-index: 100;
  }

  .lang-compact {
    position: relative;
  }

  /* 圆形按钮：与居中导航胶囊通过同一套 Utopia 高度公式保持同高同顶边。 */
  .lang-compact summary {
    --pill-size: calc(var(--spacing-3xs) * 2 + var(--spacing-2xs) * 2 + var(--text-step--1) * 1.4 + 2px);
    view-transition-name: lang-pill;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--pill-size);
    height: var(--pill-size);
    margin: 0;
    padding: 0;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    /* 小圆不用背景模糊，也不用 inset 白高光：模糊层在圆形边缘会留下 1px 合成接缝，
       白高光叠在强调色填充上就是一整圈月牙。 */
    background: var(--color-bg);
    box-shadow:
      0 1px 3px var(--color-shadow-soft),
      0 10px 30px var(--color-shadow-soft);
    font-size: var(--text-step--1);
    line-height: 1;
    letter-spacing: 0;
    color: var(--color-ink-2);
    cursor: pointer;
    list-style: none;
  }

  .lang-compact summary::-webkit-details-marker {
    display: none;
  }

  .lang-compact summary:focus-visible {
    outline: 2px solid var(--color-accent-deep);
    outline-offset: 3px;
  }

  .lang-compact[open] summary {
    color: var(--color-ink);
    background: color-mix(in srgb, var(--color-bg) 95.5%, var(--color-ink));
    box-shadow: 0 1px 3px var(--color-shadow-soft);
  }

  /* 中日文字形的基线偏移在 flex 居中下最稳；西文短码用同一盒模型居中。 */
  .mark {
    display: block;
    line-height: 1;
  }

  .lang-menu {
    position: absolute;
    top: calc(100% + var(--spacing-2xs));
    right: 0;
    min-width: 148px;
    padding: var(--spacing-3xs);
    border: 1px solid var(--color-line);
    border-radius: 18px;
    background: var(--color-glass);
    -webkit-backdrop-filter: blur(20px) saturate(1.7);
    backdrop-filter: blur(20px) saturate(1.7);
    box-shadow:
      inset 0 1px 0 var(--color-glass-hi),
      0 1px 3px var(--color-shadow-soft),
      0 10px 30px var(--color-shadow-soft);
    transform-origin: top right;
  }

  .lang[data-ready] .lang-menu {
    opacity: 0;
    transform: scale(0.75);
    pointer-events: none;
    transition:
      opacity 0.18s ease,
      transform 0.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .lang[data-ready] .lang-compact.is-open .lang-menu {
    opacity: 1;
    transform: scale(1);
    pointer-events: auto;
  }

  .lang-track {
    position: relative;
  }

  .lang-active,
  .lang-hover {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    border-radius: 12px;
    pointer-events: none;
    z-index: 0;
  }

  .lang-active {
    background: var(--color-accent-current);
    opacity: 0;
  }

  .lang-hover {
    background: var(--color-hover-fill);
    opacity: 0;
    transition:
      transform 0.24s cubic-bezier(0.22, 1, 0.36, 1),
      height 0.24s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.18s ease;
  }

  .lang-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lang-menu a {
    position: relative;
    z-index: 1;
    display: block;
    padding: var(--spacing-2xs) var(--spacing-s);
    border-radius: 12px;
    font-size: var(--text-step--1);
    line-height: 1.4;
    letter-spacing: 0.03em;
    white-space: nowrap;
    color: var(--color-ink-2);
    transition:
      color 0.2s ease,
      background 0.2s ease;
  }

  .lang-menu a:hover {
    color: var(--color-ink);
    background: var(--color-hover-fill);
  }

  .lang-menu a[aria-current='true'] {
    color: var(--color-ink);
    background: var(--color-accent-current);
  }

  .lang[data-ready] .lang-menu a:hover,
  .lang[data-ready] .lang-menu a[aria-current='true'] {
    background: transparent;
  }

  @media (prefers-reduced-motion: reduce) {
    .lang-hover {
      transition: opacity 0.15s ease;
    }

    .lang[data-ready] .lang-menu {
      transform: none;
      transition: opacity 0.12s ease;
    }
  }

  /* 与导航胶囊同步的窄屏收缩。 */
  @media (max-width: 560px) {
    .lang {
      top: var(--spacing-xs);
    }
  }
</style>
