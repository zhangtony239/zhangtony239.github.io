---
import {
  DEFAULT_LOCALE,
  HTML_LANG,
  LOCALE_LABELS,
  LOCALE_SHORT_LABELS,
  LOCALES,
  type Locale,
} from '../i18n/config';
import { useUi } from '../i18n/ui';

interface Props {
  /** 当前页面语言。 */
  locale?: Locale;
  /** 每个语言对应的目标路径；缺译时由页面传入该语言首页。 */
  paths: Record<Locale, string>;
}

const { locale = DEFAULT_LOCALE, paths } = Astro.props;
const ui = useUi(locale);

const entries = LOCALES.map((item) => ({
  locale: item,
  label: LOCALE_LABELS[item],
  short: LOCALE_SHORT_LABELS[item],
  href: paths[item],
  lang: HTML_LANG[item],
  isCurrent: item === locale,
}));
---

<div class="lang">
  <details class="lang-compact">
    <summary aria-label={`${ui.language.menuLabel}: ${LOCALE_LABELS[locale]}`}>
      <span class="mark" aria-hidden="true">{LOCALE_SHORT_LABELS[locale]}</span>
      <span class="sr-only">{LOCALE_LABELS[locale]}</span>
    </summary>
    <ul class="lang-menu">
      {
        entries.map((entry) => (
          <li>
            <a
              href={entry.href}
              hreflang={entry.lang}
              lang={entry.lang}
              aria-current={entry.isCurrent ? 'true' : undefined}
              data-locale-link={entry.locale}
            >
              {entry.label}
            </a>
          </li>
        ))
      }
    </ul>
  </details>
</div>

<script is:inline>
  document.addEventListener('click', function (event) {
    var target = event.target;
    var link = target instanceof Element ? target.closest('[data-locale-link]') : null;
    if (!link) return;

    try {
      window.localStorage.setItem('locale', link.getAttribute('data-locale-link') || '');
    } catch (error) {
      /* 本地存储不可用时静默失败：链接照常导航，只是不记住偏好。 */
    }
  });
</script>

<style>
  .lang {
    position: fixed;
    top: 18px;
    right: max(12px, calc(var(--pad-x) / 2));
    z-index: 100;
  }

  .lang-compact {
    position: relative;
  }

  /* 圆形按钮：与居中导航胶囊同高同顶边，字形用 flex 居中并压平行高避免偏移。 */
  .lang-compact summary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 50px;
    height: 50px;
    margin: 0;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--glass);
    -webkit-backdrop-filter: blur(20px) saturate(1.7);
    backdrop-filter: blur(20px) saturate(1.7);
    box-shadow:
      inset 0 1px 0 var(--glass-hi),
      0 1px 3px var(--shadow-soft),
      0 10px 30px var(--shadow-soft);
    font-size: 13.5px;
    line-height: 1;
    letter-spacing: 0;
    color: var(--ink-2);
    cursor: pointer;
    list-style: none;
  }

  .lang-compact summary::-webkit-details-marker {
    display: none;
  }

  .lang-compact summary:focus-visible {
    outline: 2px solid var(--accent-deep);
    outline-offset: 3px;
  }

  .lang-compact[open] summary {
    color: var(--ink);
    background: var(--accent-current);
  }

  /* 中日文字形的基线偏移在 flex 居中下最稳；西文短码用同一盒模型居中。 */
  .mark {
    display: block;
    line-height: 1;
  }

  .lang-menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 148px;
    margin: 0;
    padding: 5px;
    list-style: none;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--glass);
    -webkit-backdrop-filter: blur(20px) saturate(1.7);
    backdrop-filter: blur(20px) saturate(1.7);
    box-shadow:
      inset 0 1px 0 var(--glass-hi),
      0 1px 3px var(--shadow-soft),
      0 10px 30px var(--shadow-soft);
  }

  .lang-menu a {
    display: block;
    padding: 8px 14px;
    border-radius: 12px;
    font-size: 13.5px;
    line-height: 1.4;
    letter-spacing: 0.03em;
    white-space: nowrap;
    color: var(--ink-2);
    transition:
      color 0.2s ease,
      background 0.2s ease;
  }

  .lang-menu a:hover {
    color: var(--ink);
    background: var(--hover-fill);
  }

  .lang-menu a[aria-current='true'] {
    color: var(--ink);
    background: var(--accent-current);
  }

  /* 与导航胶囊同步的窄屏收缩：顶边下移、按钮边长随之变小。 */
  @media (max-width: 560px) {
    .lang {
      top: 12px;
    }

    .lang-compact summary {
      width: 44px;
      height: 44px;
      font-size: 12.5px;
    }
  }
</style>
