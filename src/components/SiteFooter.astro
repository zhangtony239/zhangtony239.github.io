---
import { FOOTER_LINKS } from '../consts';
import { DEFAULT_LOCALE, type Locale } from '../i18n/config';
import { useUi } from '../i18n/ui';

interface Props {
  /** 当前页面语言，决定页脚无障碍文案。 */
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const ui = useUi(locale);
const year = new Date().getFullYear();
---

<footer class="footer">
  <p class="copy">© {year} Tony Zhang. CC BY 4.0</p>
  <nav class="links" aria-label={ui.footer.externalLinks}>
    {FOOTER_LINKS.map((link) => <a href={link.href}>{link.label}</a>)}
  </nav>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs) var(--spacing-m);
    align-items: center;
    justify-content: space-between;
    padding: var(--spacing-m) var(--spacing-pad-x) var(--spacing-l);
    border-top: 1px solid var(--color-line);
    background: var(--color-glass);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    backdrop-filter: blur(16px) saturate(1.4);
    font-family: var(--font-mono);
    font-size: var(--text-step--2);
    letter-spacing: 0.07em;
    color: var(--color-ink-3);
  }

  .copy {
    margin: 0;
  }

  .links {
    display: flex;
    gap: var(--spacing-s);
  }

  .links a {
    transition: color 0.2s ease;
  }

  .links a:hover {
    color: var(--color-accent-deep);
  }
</style>
