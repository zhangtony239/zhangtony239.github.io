---
import { FOOTER_LINKS } from '../consts';
import { DEFAULT_LOCALE, type Locale } from '../i18n/config';
import { useUi } from '../i18n/ui';

interface Props {
  /** 当前页面语言，决定页脚无障碍文案。 */
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const ui = useUi(locale);
const year = new Date().getFullYear();
---

<footer class="footer">
  <p class="copy">© {year} Tony Zhang. CC BY 4.0</p>
  <nav class="links" aria-label={ui.footer.externalLinks}>
    {FOOTER_LINKS.map((link) => <a href={link.href}>{link.label}</a>)}
  </nav>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 14px 28px;
    align-items: center;
    justify-content: space-between;
    padding: 26px var(--pad-x) 34px;
    border-top: 1px solid var(--line);
    background: var(--glass);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    backdrop-filter: blur(16px) saturate(1.4);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.07em;
    color: var(--ink-3);
  }

  .copy {
    margin: 0;
  }

  .links {
    display: flex;
    gap: 20px;
  }

  .links a {
    transition: color 0.2s ease;
  }

  .links a:hover {
    color: var(--accent-deep);
  }
</style>
