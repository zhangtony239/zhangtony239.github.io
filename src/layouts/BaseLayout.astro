---
import '../styles/global.css';
import NavPill from '../components/NavPill.astro';
import LanguagePill from '../components/LanguagePill.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE_NAME } from '../consts';
import {
  DEFAULT_LOCALE,
  HTML_LANG,
  LOCALES,
  type Alternate,
  type Locale,
  localizedPath,
  stripLocale,
} from '../i18n/config';

interface Props {
  /** 文档标题；文章页传入「标题 · 站点名」。 */
  title?: string;
  /** 当前页面语言，决定 <html lang>、外壳文案与 hreflang。 */
  locale?: Locale;
  /** 三语 alternate 链接；缺省时按当前页面路径镜像出三语版本。 */
  alternates?: Alternate[];
  /** 语言胶囊的三语目标路径；缺省时按当前页面路径镜像（缺译页面由调用方覆盖）。 */
  localePaths?: Record<Locale, string>;
}

const { title = SITE_NAME, locale = DEFAULT_LOCALE, alternates, localePaths } = Astro.props;

/** 归一到无尾斜杠的页面路径（首页除外），使 alternate 链接与站内链接形态一致。 */
const pagePath = stripLocale(Astro.url.pathname).replace(/\/+$/, '') || '/';
const links: Alternate[] =
  alternates ??
  LOCALES.map((item) => ({ locale: item, href: localizedPath(item, pagePath) }));
const xDefault = links.find((link) => link.locale === DEFAULT_LOCALE)?.href ?? links[0]?.href;

const switchPaths: Record<Locale, string> =
  localePaths ??
  LOCALES.reduce(
    (paths, item) => {
      paths[item] = localizedPath(item, pagePath);
      return paths;
    },
    {} as Record<Locale, string>,
  );
---

<!doctype html>
<html lang={HTML_LANG[locale]} data-locale={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {
      links.map((link) => (
        <link rel="alternate" hreflang={HTML_LANG[link.locale]} href={link.href} />
      ))
    }
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:opsz,wght@1..144,1..1000&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <NavPill locale={locale} />
    <LanguagePill locale={locale} paths={switchPaths} />
    <slot />
    <SiteFooter locale={locale} />
  </body>
</html>
