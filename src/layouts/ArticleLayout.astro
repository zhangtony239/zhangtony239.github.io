---
import BaseLayout from './BaseLayout.astro';
import { AIGC_NOTICE_PATH, SITE_NAME } from '../consts';
import { DEFAULT_LOCALE, type Alternate, type Locale } from '../i18n/config';
import { useUi } from '../i18n/ui';
import { formatDate } from '../lib/essays';

interface Props {
  title: string;
  date: Date;
  /** 写作过程中是否使用了 AIGC 处理；为真时渲染文末披露标记。 */
  aigc?: boolean;
  /** 披露说明文档的链接，默认取站点常量。 */
  aigcNoticeHref?: string;
  /** 当前页面语言，决定披露文案与日期展示。 */
  locale?: Locale;
  /** 三语 alternate 链接；缺省时由 BaseLayout 按当前路径镜像。 */
  alternates?: Alternate[];
}

const {
  title,
  date,
  aigc = false,
  aigcNoticeHref = AIGC_NOTICE_PATH,
  locale = DEFAULT_LOCALE,
  alternates,
} = Astro.props;

const ui = useUi(locale);
---

<BaseLayout title={`${title} · ${SITE_NAME}`} {locale} {alternates}>
  <main class="article-page">
    <article class="article">
      <header class="article-header">
        <h1>{title}</h1>
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
      </header>
      <div class="prose">
        <slot />
      </div>
      {
        aigc && (
          <p class="aigc-note">
            <a href={aigcNoticeHref}>*{ui.aigc.noticeLabel}</a>
          </p>
        )
      }
    </article>
  </main>
</BaseLayout>

<style>
  .article-page {
    padding: calc(var(--nav-h) + 76px) var(--pad-x) 104px;
  }

  .article {
    max-width: 62ch;
    margin: 0 auto;
  }

  .article-header {
    margin-bottom: 2.6em;
  }

  .article-header h1 {
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    font-weight: 400;
    line-height: 1.22;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .article-header time {
    display: block;
    margin-top: 14px;
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.06em;
    color: var(--ink-3);
  }

  /* —— 正文基线 —— */
  .prose {
    color: var(--ink-2);
    font-size: 1rem;
    line-height: 1.85;
    overflow-wrap: break-word;
  }

  .prose :global(p) {
    margin: 0 0 1.5em;
  }

  /* —— 标题层级：正文从 h2 起，不自动加序号 —— */
  .prose :global(h2) {
    margin: 2.6em 0 0.85em;
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .prose :global(h3) {
    margin: 2em 0 0.65em;
    font-size: 1.12rem;
    font-weight: 500;
    line-height: 1.45;
    color: var(--ink);
  }

  .prose :global(h4) {
    margin: 1.8em 0 0.6em;
    font-size: 1rem;
    font-weight: 500;
    color: var(--ink);
  }

  .prose :global(h2 + p),
  .prose :global(h3 + p),
  .prose :global(h4 + p) {
    margin-top: 0;
  }

  /* —— 引用块：左侧细线 + 略大字号，不用浏览器默认斜体缩进 —— */
  .prose :global(blockquote) {
    margin: 2.2em 0;
    padding-left: 1.2em;
    border-left: 1px solid var(--line);
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--ink);
  }

  .prose :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  /* —— 列表 —— */
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.5em;
    padding-left: 1.35em;
  }

  .prose :global(li) {
    margin: 0.45em 0;
  }

  .prose :global(li::marker) {
    color: var(--ink-3);
  }

  /* —— 强调与行内代码 —— */
  .prose :global(strong) {
    font-weight: 600;
    color: var(--ink);
  }

  .prose :global(em) {
    font-style: italic;
  }

  .prose :global(code) {
    padding: 0.15em 0.4em;
    border-radius: 4px;
    background: var(--code-bg);
    font-family: var(--mono);
    font-size: 0.9em;
    color: var(--ink);
  }

  .prose :global(pre) {
    margin: 0 0 1.5em;
    padding: 1em 1.2em;
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--code-bg);
  }

  .prose :global(pre code) {
    padding: 0;
    background: none;
    font-size: 0.88em;
  }

  .prose :global(a) {
    color: var(--accent-deep);
  }

  /*
   * 表格：突破 62ch 阅读栏到 92ch，并自带横向滚动。
   * display:block 让表格本身成为滚动容器，窄屏时只有表格横向滚动，
   * 页面不出现横向滚动条（body 已设 overflow-x: hidden）。
   */
  .prose :global(table) {
    display: block;
    width: min(92ch, 100vw - 48px);
    margin-inline: calc((100% - min(92ch, 100vw - 48px)) / 2);
    margin-block: 0 1.8em;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .prose :global(th),
  .prose :global(td) {
    min-width: 110px;
    padding: 13px 16px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--line);
  }

  .prose :global(th) {
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--ink-3);
    white-space: nowrap;
  }

  .prose :global(td) {
    color: var(--ink-2);
  }

  .prose :global(hr) {
    margin: 2.6em 0;
    border: 0;
    border-top: 1px solid var(--line);
  }

  /* —— AIGC 披露标记：注脚身份，视觉弱于正文链接 —— */
  .aigc-note {
    margin: 2.5em 0 0;
    font-size: 11.5px;
    line-height: 1.7;
    letter-spacing: 0.02em;
    color: var(--ink-3);
  }

  .aigc-note a {
    color: inherit;
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .aigc-note a:hover {
    color: var(--ink-2);
    text-decoration: underline;
  }
</style>
